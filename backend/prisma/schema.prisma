// Schema CSDL – website đặt vé xe khách liên tỉnh (bản 2: đủ bảng cho 35 chức năng).
// Quy ước: tên model/field camelCase trong code, tên bảng/cột snake_case trong PostgreSQL (@map / @@map).
// Mọi thay đổi bảng phải đi kèm migration: npx prisma migrate dev --name <ten-thay-doi>

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  CUSTOMER
  STAFF
  ADMIN
}

enum Gender {
  MALE
  FEMALE
  OTHER
}

enum StopType {
  PICKUP
  DROPOFF
  BOTH
}

enum TripStatus {
  SCHEDULED
  CANCELLED
  COMPLETED
}

// Trạng thái "đang giữ" KHÔNG lưu ở đây mà nằm trong Redis có thời hạn (TTL).
enum TripSeatStatus {
  AVAILABLE
  SOLD
  BLOCKED
}

enum BookingStatus {
  PENDING_PAYMENT
  PAID
  CANCELLED
  EXPIRED
  PAYMENT_FAILED
  NEEDS_REFUND // đã trả tiền nhưng ghế không còn (khó khăn #13 trong kế hoạch)
}

enum BookingChannel {
  ONLINE
  COUNTER
}

enum PaymentStatus {
  PENDING
  SUCCESS
  FAILED
  REFUNDED
}

enum SupportType {
  QUESTION
  COMPLAINT
  HANDOFF // chatbot chuyển cho nhân viên
}

enum SupportStatus {
  OPEN
  ANSWERED
  CLOSED
}

model User {
  id              Int              @id @default(autoincrement())
  fullName        String           @map("full_name")
  email           String           @unique
  phone           String
  passwordHash    String           @map("password_hash")
  role            Role             @default(CUSTOMER)
  isLocked        Boolean          @default(false) @map("is_locked")
  createdAt       DateTime         @default(now()) @map("created_at")
  updatedAt       DateTime         @updatedAt @map("updated_at")
  bookings        Booking[]        @relation("BookingUser")
  soldBookings    Booking[]        @relation("BookingSoldBy")
  chatSessions    ChatSession[]
  savedPassengers SavedPassenger[]
  passwordResets  PasswordReset[]
  reviews         Review[]
  supportRequests SupportRequest[] @relation("SupportUser")
  supportReplies  SupportRequest[] @relation("SupportRepliedBy")
  auditLogs       AuditLog[]

  @@map("users")
}

// Để sẵn bảng nhà xe để sau này mở rộng thành sàn nhiều nhà xe.
model Operator {
  id        Int      @id @default(autoincrement())
  name      String
  hotline   String?
  /// Đường dẫn logo (ảnh trong frontend/public/nha-xe)
  logoUrl   String?  @map("logo_url")
  createdAt DateTime @default(now()) @map("created_at")
  routes    Route[]
  buses     Bus[]

  @@map("operators")
}

model Route {
  id              Int            @id @default(autoincrement())
  operatorId      Int            @map("operator_id")
  originCity      String         @map("origin_city")
  destinationCity String         @map("destination_city")
  distanceKm      Int?           @map("distance_km")
  durationMinutes Int?           @map("duration_minutes")
  isActive        Boolean        @default(true) @map("is_active")
  createdAt       DateTime       @default(now()) @map("created_at")
  operator        Operator       @relation(fields: [operatorId], references: [id])
  stops           Stop[]
  trips           Trip[]
  schedules       TripSchedule[]

  @@index([originCity, destinationCity])
  @@map("routes")
}

model Stop {
  id              Int       @id @default(autoincrement())
  routeId         Int       @map("route_id")
  name            String
  address         String
  type            StopType
  orderNo         Int       @map("order_no")
  // số phút so với giờ xuất bến (điểm đón sau 30 phút → 30)
  offsetMinutes   Int       @default(0) @map("offset_minutes")
  lat             Float?
  lng             Float?
  route           Route     @relation(fields: [routeId], references: [id], onDelete: Cascade)
  pickupBookings  Booking[] @relation("PickupStop")
  dropoffBookings Booking[] @relation("DropoffStop")

  @@unique([routeId, orderNo])
  @@map("stops")
}

model SeatLayout {
  id     Int    @id @default(autoincrement())
  name   String
  floors Int
  rows   Int
  cols   Int
  seats  Seat[]
  buses  Bus[]

  @@map("seat_layouts")
}

model Seat {
  id         Int        @id @default(autoincrement())
  layoutId   Int        @map("layout_id")
  code       String // ví dụ A01 (tầng dưới), B01 (tầng trên)
  floor      Int
  rowNo      Int        @map("row_no")
  colNo      Int        @map("col_no")
  priceExtra Int        @default(0) @map("price_extra") // phụ thu so với giá chuyến (VNĐ)
  femaleOnly Boolean    @default(false) @map("female_only") // ghế dành cho nữ
  layout     SeatLayout @relation(fields: [layoutId], references: [id], onDelete: Cascade)
  tripSeats  TripSeat[]

  @@unique([layoutId, code])
  @@map("seats")
}

model Bus {
  id           Int            @id @default(autoincrement())
  operatorId   Int            @map("operator_id")
  plateNumber  String         @unique @map("plate_number")
  busType      String         @map("bus_type")
  seatLayoutId Int            @map("seat_layout_id")
  amenities    String[]       @default([]) // ví dụ: Wi-Fi, Nước uống, Chăn, Cổng sạc USB
  /// Ảnh xe (đường dẫn trong frontend/public/xe), ảnh đầu tiên là ảnh đại diện
  photos       String[]       @default([])
  operator     Operator       @relation(fields: [operatorId], references: [id])
  layout       SeatLayout     @relation(fields: [seatLayoutId], references: [id])
  trips        Trip[]
  schedules    TripSchedule[]

  @@map("buses")
}

// Lịch chạy lặp hằng ngày, dùng để tạo chuyến hàng loạt (F27)
model TripSchedule {
  id              Int      @id @default(autoincrement())
  routeId         Int      @map("route_id")
  busId           Int      @map("bus_id")
  departTime      String   @map("depart_time") // "HH:mm" giờ Việt Nam
  durationMinutes Int      @map("duration_minutes")
  basePrice       Int      @map("base_price")
  isActive        Boolean  @default(true) @map("is_active")
  createdAt       DateTime @default(now()) @map("created_at")
  route           Route    @relation(fields: [routeId], references: [id])
  bus             Bus      @relation(fields: [busId], references: [id])
  trips           Trip[]

  @@map("trip_schedules")
}

model Trip {
  id         Int           @id @default(autoincrement())
  routeId    Int           @map("route_id")
  busId      Int           @map("bus_id")
  scheduleId Int?          @map("schedule_id")
  departAt   DateTime      @map("depart_at") // lưu UTC, hiển thị giờ Việt Nam
  arriveAt   DateTime      @map("arrive_at")
  basePrice  Int           @map("base_price") // VNĐ
  status     TripStatus    @default(SCHEDULED)
  createdAt  DateTime      @default(now()) @map("created_at")
  route      Route         @relation(fields: [routeId], references: [id])
  bus        Bus           @relation(fields: [busId], references: [id])
  schedule   TripSchedule? @relation(fields: [scheduleId], references: [id])
  tripSeats  TripSeat[]
  bookings   Booking[]
  reviews    Review[]

  @@unique([scheduleId, departAt])
  @@index([routeId, departAt])
  @@map("trips")
}

// Mỗi ghế của mỗi chuyến là 1 dòng. UNIQUE(trip_id, seat_id) + cập nhật có điều kiện
// (status = AVAILABLE) là lớp chặn cuối cùng chống bán trùng ghế.
model TripSeat {
  id        Int            @id @default(autoincrement())
  tripId    Int            @map("trip_id")
  seatId    Int            @map("seat_id")
  status    TripSeatStatus @default(AVAILABLE)
  bookingId Int?           @map("booking_id")
  trip      Trip           @relation(fields: [tripId], references: [id], onDelete: Cascade)
  seat      Seat           @relation(fields: [seatId], references: [id])
  booking   Booking?       @relation(fields: [bookingId], references: [id])
  items     BookingItem[]

  @@unique([tripId, seatId])
  @@index([bookingId])
  @@map("trip_seats")
}

model Booking {
  id                Int            @id @default(autoincrement())
  code              String         @unique // mã vé ngẫu nhiên, không dùng id tăng dần
  userId            Int?           @map("user_id")
  soldById          Int?           @map("sold_by_id") // nhân viên bán tại quầy
  channel           BookingChannel @default(ONLINE)
  tripId            Int            @map("trip_id")
  pickupStopId      Int            @map("pickup_stop_id")
  dropoffStopId     Int            @map("dropoff_stop_id")
  contactName       String         @map("contact_name")
  contactPhone      String         @map("contact_phone")
  contactEmail      String         @map("contact_email")
  couponId          Int?           @map("coupon_id")
  discountAmount    Int            @default(0) @map("discount_amount")
  totalAmount       Int            @map("total_amount") // đã trừ giảm giá
  status            BookingStatus  @default(PENDING_PAYMENT)
  expiresAt         DateTime       @map("expires_at")
  cancelledAt       DateTime?      @map("cancelled_at")
  refundAmount      Int?           @map("refund_amount")
  changedFromTripId Int?           @map("changed_from_trip_id")
  reminderSentAt    DateTime?      @map("reminder_sent_at")
  createdAt         DateTime       @default(now()) @map("created_at")
  updatedAt         DateTime       @updatedAt @map("updated_at")
  user              User?          @relation("BookingUser", fields: [userId], references: [id])
  soldBy            User?          @relation("BookingSoldBy", fields: [soldById], references: [id])
  trip              Trip           @relation(fields: [tripId], references: [id])
  pickupStop        Stop           @relation("PickupStop", fields: [pickupStopId], references: [id])
  dropoffStop       Stop           @relation("DropoffStop", fields: [dropoffStopId], references: [id])
  coupon            Coupon?        @relation(fields: [couponId], references: [id])
  items             BookingItem[]
  payments          Payment[]
  tripSeats         TripSeat[]
  review            Review?

  @@index([userId])
  @@index([contactPhone])
  @@index([status, expiresAt])
  @@map("bookings")
}

model BookingItem {
  id            Int       @id @default(autoincrement())
  bookingId     Int       @map("booking_id")
  tripSeatId    Int       @map("trip_seat_id")
  passengerName String?   @map("passenger_name")
  gender        Gender?
  age           Int?
  price         Int
  checkedInAt   DateTime? @map("checked_in_at")
  booking       Booking   @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  tripSeat      TripSeat  @relation(fields: [tripSeatId], references: [id])

  @@unique([bookingId, tripSeatId])
  @@map("booking_items")
}

model Payment {
  id        Int           @id @default(autoincrement())
  bookingId Int           @map("booking_id")
  provider  String // mock | vnpay | cash
  txnRef    String        @unique @map("txn_ref")
  amount    Int
  status    PaymentStatus @default(PENDING)
  rawData   Json?         @map("raw_data")
  paidAt    DateTime?     @map("paid_at")
  createdAt DateTime      @default(now()) @map("created_at")
  booking   Booking       @relation(fields: [bookingId], references: [id])

  @@index([bookingId])
  @@map("payments")
}

model Coupon {
  id          Int       @id @default(autoincrement())
  code        String    @unique
  description String?
  percent     Int? // giảm theo % (1–100)
  amount      Int? // hoặc giảm số tiền cố định (VNĐ)
  maxDiscount Int?      @map("max_discount")
  minOrder    Int       @default(0) @map("min_order")
  usageLimit  Int?      @map("usage_limit")
  usedCount   Int       @default(0) @map("used_count")
  validFrom   DateTime  @map("valid_from")
  validTo     DateTime  @map("valid_to")
  isActive    Boolean   @default(true) @map("is_active")
  createdAt   DateTime  @default(now()) @map("created_at")
  bookings    Booking[]

  @@map("coupons")
}

model Review {
  id        Int      @id @default(autoincrement())
  bookingId Int      @unique @map("booking_id")
  tripId    Int      @map("trip_id")
  userId    Int      @map("user_id")
  rating    Int // 1–5
  comment   String?
  createdAt DateTime @default(now()) @map("created_at")
  booking   Booking  @relation(fields: [bookingId], references: [id])
  trip      Trip     @relation(fields: [tripId], references: [id])
  user      User     @relation(fields: [userId], references: [id])

  @@index([tripId])
  @@map("reviews")
}

model SavedPassenger {
  id        Int      @id @default(autoincrement())
  userId    Int      @map("user_id")
  fullName  String   @map("full_name")
  phone     String?
  gender    Gender?
  age       Int?
  createdAt DateTime @default(now()) @map("created_at")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("saved_passengers")
}

model PasswordReset {
  id        Int       @id @default(autoincrement())
  userId    Int       @map("user_id")
  tokenHash String    @unique @map("token_hash") // chỉ lưu bản băm, không lưu mã gốc
  expiresAt DateTime  @map("expires_at")
  usedAt    DateTime? @map("used_at")
  createdAt DateTime  @default(now()) @map("created_at")
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("password_resets")
}

model SupportRequest {
  id            Int           @id @default(autoincrement())
  userId        Int?          @map("user_id")
  type          SupportType   @default(QUESTION)
  bookingCode   String?       @map("booking_code")
  contactPhone  String?       @map("contact_phone")
  subject       String
  message       String        @db.Text
  status        SupportStatus @default(OPEN)
  reply         String?       @db.Text
  repliedAt     DateTime?     @map("replied_at")
  repliedById   Int?          @map("replied_by_id")
  chatSessionId String?       @map("chat_session_id")
  createdAt     DateTime      @default(now()) @map("created_at")
  user          User?         @relation("SupportUser", fields: [userId], references: [id])
  repliedBy     User?         @relation("SupportRepliedBy", fields: [repliedById], references: [id])

  @@index([status])
  @@map("support_requests")
}

model AuditLog {
  id        Int      @id @default(autoincrement())
  userId    Int?     @map("user_id")
  method    String
  path      String
  status    Int
  detail    Json?
  createdAt DateTime @default(now()) @map("created_at")
  user      User?    @relation(fields: [userId], references: [id])

  @@index([createdAt])
  @@map("audit_logs")
}

// Bảng phụ cho bản xem trước: lưu mọi email hệ thống gửi để xem trong trang quản trị khi chưa có máy chủ mail.
model MailLog {
  id        Int      @id @default(autoincrement())
  to        String
  subject   String
  html      String   @db.Text
  via       String // OUTBOX (chưa cấu hình SMTP) | SMTP
  createdAt DateTime @default(now()) @map("created_at")

  @@map("mail_logs")
}

// ----- Chatbot -----

model KbDocument {
  id        Int      @id @default(autoincrement())
  title     String
  content   String   @db.Text
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("kb_documents")
}

model ChatSession {
  id        String        @id @default(uuid())
  userId    Int?          @map("user_id")
  startedAt DateTime      @default(now()) @map("started_at")
  user      User?         @relation(fields: [userId], references: [id])
  messages  ChatMessage[]

  @@map("chat_sessions")
}

model ChatMessage {
  id        Int         @id @default(autoincrement())
  sessionId String      @map("session_id")
  role      String // user | assistant
  content   String      @db.Text
  createdAt DateTime    @default(now()) @map("created_at")
  session   ChatSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId])
  @@map("chat_messages")
}
